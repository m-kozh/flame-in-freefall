# --- Backend (FastAPI model) ---
# Base URL of the backend. Leave empty to use the built-in mock model.
# Browser calls go to /backend/* and are proxied here server-side (no CORS needed).
BACKEND_URL=

# --- AI chat (server-side only, never exposed to the browser) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Max chat requests per visitor IP per 10 minutes
CHAT_RATE_LIMIT=20
